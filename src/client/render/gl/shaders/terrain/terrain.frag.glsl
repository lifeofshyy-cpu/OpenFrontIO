#version 300 es
precision highp float;
precision highp usampler2D;

// Fantasy-map terrain, pixel-art style. Water keeps the baked colours. Land
// is three flat zones with clean edges — open country, forest (highland) and
// mountains — taken from a smoothed elevation field, with ink coasts and
// overlapping sprites that turn the zones into ranges and woods.
//
// Defines injected by TerrainPass: MAP_W, MAP_H, FANTASY_GLYPHS (0 | 1) and,
// with FANTASY_GLYPHS, ELEV_W / ELEV_H (the elevation texture's extent in
// tiles). Without FANTASY_GLYPHS the baked terrain colours are drawn as-is.

uniform sampler2D uTerrain;
#if FANTASY_GLYPHS
// Raw terrain bytes (R8UI): bit 7 land, bit 6 shoreline, bits 0-4 magnitude.
uniform usampler2D uTerrainBytes;
// Smoothed land elevation (R8, bilinear): magnitude × 8 / 255.
uniform sampler2D uElevation;
// Zone colours from render settings (0-1 RGB): open land, forest, mountain.
uniform vec3 uPlains;
uniform vec3 uHighland;
uniform vec3 uMountain;
#endif

in vec2 vUV;
out vec4 fragColor;

#if FANTASY_GLYPHS
const vec3 INK = vec3(0.31, 0.10, 0.14);
// Smallest glyph cell, in tiles, and the on-screen size (px) a cell is kept
// near: cells double in size each time the camera zooms out 2x.
const float BASE_CELL = 10.0;
const float TARGET_PX = 56.0;
const float MAX_LOD = 5.0;
// Sprite size relative to its cell. Above 1 so neighbours overlap.
const float GLYPH_SPAN = 1.3;
// Smoothed magnitude at which forest and mountain zones begin.
const float FOREST_AT = 10.0;
const float MOUNTAIN_AT = 16.0;

// GLYPH-DATA-BEGIN (generated by scripts/gen-terrain-glyphs.mjs)
const int GLYPH_COUNT = 9;
const uint GLYPH_ROWS[144] = uint[144](
  0x00000000u, 0x00000000u, 0x00014000u, 0x00069000u,
  0x001a9400u, 0x001ad500u, 0x006ad540u, 0x006bd740u,
  0x01ab5750u, 0x01af55d0u, 0x06afd5d4u, 0x06bf7574u,
  0x1abf55f4u, 0x1aff757cu, 0x2bff55f0u, 0x0fff14c0u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00400000u, 0x01900100u, 0x06a40640u, 0x06b51a50u,
  0x1ab56ad0u, 0x1af5abd4u, 0x6af6af54u, 0x6bf6bf55u,
  0x2ffaff54u, 0x0fcbfc50u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00a00000u,
  0x02f80280u, 0x0bfe0be0u, 0x0fffeff8u, 0x2ffffffcu,
  0xbfebffffu, 0xfffeffffu, 0xfffffaffu, 0xdfffefbfu,
  0x17f7fff4u, 0x0417fd44u, 0x00045100u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000a00u,
  0x00a02f80u, 0x02f8bfc0u, 0x2bfefff8u, 0xbefffffeu,
  0xffffebffu, 0xffafbeffu, 0xfefbffffu, 0xfffffff7u,
  0x1ffdff54u, 0x14d5fd10u, 0x04111400u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00100000u, 0x00640040u,
  0x01ad0190u, 0x06bd06b4u, 0x1afd1af4u, 0x6bfd6bf4u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x05001400u,
  0x00514000u, 0x00040050u, 0x00000505u, 0x00001000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x0aa00a80u, 0x00000000u, 0x002aa000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00010000u, 0x00050000u, 0x00191000u,
  0x00696400u, 0x01a9a900u, 0x01a9a900u, 0x06a9aa40u,
  0x05545540u, 0x00010000u, 0x15555554u, 0x07ffffd0u,
  0x01555540u, 0x00000000u, 0x2aa0aa00u, 0x00aaa000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x15000000u, 0x65400000u,
  0x55405414u, 0x0741751du, 0x07450141u, 0x07540040u,
  0x00000000u, 0x2a82aa2au, 0x00000000u, 0x00000000u
);
// GLYPH-DATA-END

// Sprite ids, in the order the generator lists them.
const int G_MOUNTAIN = 0;
const int G_PEAKS = 1;
const int G_FOREST = 2;
const int G_FOREST_B = 3;
const int G_RIDGE = 4;
const int G_GRASS = 5;
const int G_WAVES = 6;
const int G_SHIP = 7;
const int G_SERPENT = 8;

float hash21(vec2 p) {
  p = fract(p * vec2(123.34, 456.21));
  p += dot(p, p + 45.32);
  return fract(p.x * p.y);
}

uint terrainByte(vec2 tile) {
  ivec2 tc = clamp(ivec2(floor(tile)), ivec2(0), ivec2(MAP_W - 1, MAP_H - 1));
  return texelFetch(uTerrainBytes, tc, 0).r;
}

bool isPlayableLand(uint b) {
  return (b & 0x80u) != 0u && (b & 0x1fu) != 31u;
}

// Open water: not land, and not touching land.
bool isOpenWater(uint b) {
  return (b & 0xc0u) == 0u;
}

// 1 on land tiles that touch water (the coastline and river banks).
float coastAt(vec2 tile) {
  uint b = terrainByte(tile);
  return ((b & 0xc0u) == 0xc0u && (b & 0x1fu) != 31u) ? 1.0 : 0.0;
}

// Smoothed magnitude (0-30) around a tile.
float elevation(vec2 tile) {
  vec2 uv = tile / vec2(float(ELEV_W), float(ELEV_H));
  return texture(uElevation, uv).r * (255.0 / 8.0);
}

// 0 = open land, 1 = forest, 2 = mountain.
int zoneOf(float e) {
  if (e < FOREST_AT) return 0;
  if (e < MOUNTAIN_AT) return 1;
  return 2;
}

vec3 zoneColor(int zone) {
  if (zone == 0) return uPlains;
  if (zone == 1) return uHighland;
  return uMountain;
}

// Sprite pixel: 0 transparent, 1 outline, 2 light, 3 main colour.
uint glyphPixel(int id, int x, int y) {
  uint row = GLYPH_ROWS[id * 16 + y];
  return (row >> uint(2 * (15 - x))) & 3u;
}

vec3 glyphColor(int id, uint v) {
  bool light = v == 2u;
  if (id == G_MOUNTAIN || id == G_PEAKS) {
    if (v == 1u) return INK;
    return light ? vec3(1.0) : uMountain;
  }
  if (id == G_FOREST || id == G_FOREST_B) {
    if (v == 1u) return uHighland * 0.62;
    return light ? mix(uHighland, uPlains, 0.55) : uHighland;
  }
  if (id == G_RIDGE) {
    if (v == 1u) return INK;
    return light ? vec3(0.95, 0.66, 0.42) : vec3(0.80, 0.36, 0.22);
  }
  if (id == G_WAVES) return vec3(0.80, 0.90, 0.98);
  if (id == G_GRASS) return uPlains * 0.68;
  // Ship and serpent: pale foam and sails, dark hull and body.
  if (v == 1u) return INK;
  return light ? vec3(0.95, 0.97, 1.0) : vec3(0.55, 0.27, 0.22);
}

// The sprite of glyph cell `id` (cells are `cell` tiles wide) at map
// position `p`. `onLand` says what the fragment itself is: land sprites are
// clipped to land and sea sprites to water. Returns colour and coverage.
vec4 cellSprite(vec2 p, vec2 id, float cell, bool onLand) {
  vec2 seed = id + cell * 0.371;
  float h1 = hash21(seed);
  float h2 = hash21(seed * 1.7 + 11.3);
  float h3 = hash21(seed * 2.3 + 5.1);
  // Sprite centre in tile coordinates; it decides what gets drawn.
  vec2 c = (id + 0.5 + (vec2(h1, h2) - 0.5) * 0.2) * cell;

  // Sprite pixel under this fragment; bail out early when outside it.
  vec2 gp = floor(((p - c) / (cell * GLYPH_SPAN) + 0.5) * 16.0);
  if (gp.x < 0.0 || gp.x > 15.0 || gp.y < 0.0 || gp.y > 15.0) return vec4(0.0);

  uint b = terrainByte(c);
  int glyph;
  bool flip = h2 > 0.5;
  if (isPlayableLand(b)) {
    if (!onLand) return vec4(0.0);
    float e = elevation(c);
    int zone = zoneOf(e);
    if (zone == 2) {
      glyph = h3 < 0.6 ? G_MOUNTAIN : G_PEAKS;
      flip = false; // keep every peak's shadow on the same side
    } else if (zone == 1) {
      glyph = h3 < 0.5 ? G_FOREST : G_FOREST_B;
    } else if (e > FOREST_AT - 2.5 && h3 < 0.3) {
      glyph = G_RIDGE; // foothills at the edge of the woods
    } else if (h3 > 0.94) {
      glyph = G_GRASS;
    } else {
      return vec4(0.0);
    }
  } else {
    // Sea sprites only out on open water, clear of every coast.
    if (onLand || !isOpenWater(b)) return vec4(0.0);
    vec2 foot = vec2(0.5, 0.3) * cell;
    if (!isOpenWater(terrainByte(c - foot))) return vec4(0.0);
    if (!isOpenWater(terrainByte(c + foot))) return vec4(0.0);
    if (h3 < 0.12) {
      glyph = G_WAVES;
    } else if (h3 > 0.994) {
      glyph = G_SHIP;
    } else if (h3 > 0.989) {
      glyph = G_SERPENT;
    } else {
      return vec4(0.0);
    }
  }

  int gx = int(gp.x);
  if (flip) gx = 15 - gx;
  uint v = glyphPixel(glyph, gx, int(gp.y));
  if (v == 0u) return vec4(0.0);
  return vec4(glyphColor(glyph, v), 1.0);
}

// One layer of glyph cells. Sprites overlap their neighbours, so look at the
// cell below first (it is in front), then this row, then the cell above.
vec4 glyphLayer(vec2 p, float cell, bool onLand) {
  vec2 id = floor(p / cell);
  vec4 s = cellSprite(p, id + vec2(0.0, 1.0), cell, onLand);
  if (s.a == 0.0) s = cellSprite(p, id, cell, onLand);
  if (s.a == 0.0) s = cellSprite(p, id + vec2(-1.0, 0.0), cell, onLand);
  if (s.a == 0.0) s = cellSprite(p, id + vec2(1.0, 0.0), cell, onLand);
  if (s.a == 0.0) s = cellSprite(p, id + vec2(0.0, -1.0), cell, onLand);
  return s;
}
#endif

void main() {
  vec3 col = texture(uTerrain, vUV).rgb;

#if FANTASY_GLYPHS
  vec2 p = vUV * vec2(float(MAP_W), float(MAP_H));
  // Size of one screen pixel in tiles (bigger = zoomed further out).
  float px = max(max(fwidth(p.x), fwidth(p.y)), 1e-4);

  // --- Land: flat zones, with a dark rim under raised ones ---
  bool onLand = isPlayableLand(terrainByte(p));
  if (onLand) {
    vec2 tile = floor(p) + 0.5;
    int zone = zoneOf(elevation(tile));
    col = zoneColor(zone);
    // The rim keeps to at least a pixel and a half so it survives zooming out.
    float rim = max(2.0, 1.5 * px);
    int below = zoneOf(elevation(tile + vec2(0.0, rim)));
    if (below < zone) col = zone == 2 ? INK : uHighland * 0.62;
  }

  // --- Inked coastline ---
  // Four taps across the pixel so the one-tile line stays continuous when
  // the camera is zoomed out past one tile per pixel.
  float o = 0.25 * px;
  float coast = 0.25 * (coastAt(p + vec2(-o, -o)) + coastAt(p + vec2(o, -o)) +
    coastAt(p + vec2(-o, o)) + coastAt(p + vec2(o, o)));
  col = mix(col, INK, coast * 0.9);

  // --- Sprite glyphs ---
  // Pick the cell size that keeps glyphs near TARGET_PX on screen, and
  // cross-fade to the next size up as the camera zooms out.
  float lod = log2(px * TARGET_PX / BASE_CELL);
  float l0 = clamp(floor(lod), 0.0, MAX_LOD);
  float lf = clamp(lod - l0, 0.0, 1.0);
  // Close up (lod < 0) the glyphs would outgrow the screen: fade them out.
  float near = smoothstep(-1.0, 0.0, lod);
  float t = (lf > 0.7 && l0 < MAX_LOD) ? smoothstep(0.7, 1.0, lf) : 0.0;
  vec4 glyph = glyphLayer(p, BASE_CELL * exp2(l0), onLand);
  col = mix(col, glyph.rgb, glyph.a * (1.0 - t) * near);
  if (t > 0.0) {
    vec4 next = glyphLayer(p, BASE_CELL * exp2(l0 + 1.0), onLand);
    col = mix(col, next.rgb, next.a * t * near);
  }
#endif

  fragColor = vec4(col, 1.0);
}
