#version 300 es
precision highp float;
precision highp usampler2D;

// Fantasy-map terrain, pixel-art style: flat paper-coloured sea, land painted
// in elevation bands with striped dithering between them, dark ink coasts,
// and small sprite glyphs (peaks, forests, ridges, ships) stamped on top.
//
// Defines injected by TerrainPass: MAP_W, MAP_H, FANTASY_GLYPHS (0 | 1).
// Without FANTASY_GLYPHS the baked terrain colours are drawn as-is.

uniform sampler2D uTerrain;
#if FANTASY_GLYPHS
// Raw terrain bytes (R8UI): bit 7 land, bit 6 shoreline, bits 0-4 magnitude.
uniform usampler2D uTerrainBytes;
// Land colours from render settings (0-1 RGB).
uniform vec3 uPlains;
uniform vec3 uHighland;
uniform vec3 uMountain;
#endif

in vec2 vUV;
out vec4 fragColor;

#if FANTASY_GLYPHS
const vec3 INK = vec3(0.31, 0.10, 0.14);
// Smallest glyph cell, in tiles, and the on-screen size (px) a cell is kept
// near: cells double in size each time the camera zooms out 2x.
const float BASE_CELL = 12.0;
const float TARGET_PX = 72.0;
const float MAX_LOD = 5.0;
// Part of a cell the 16x16 sprite covers.
const float GLYPH_SPAN = 0.8;

// GLYPH-DATA-BEGIN (generated by scripts/gen-terrain-glyphs.mjs)
const int GLYPH_COUNT = 8;
const uint GLYPH_ROWS[128] = uint[128](
  0x00000000u, 0x00014000u, 0x00065000u, 0x00069000u,
  0x001a9400u, 0x001ad500u, 0x006ad500u, 0x006bd540u,
  0x01ab7540u, 0x01bf5540u, 0x06bdd550u, 0x06fd5550u,
  0x1af75550u, 0x1bf55554u, 0x6ff75555u, 0x55555555u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00500000u, 0x01940140u,
  0x01a40650u, 0x06b50690u, 0x06f546d4u, 0x1ad56f54u,
  0x1bd5ad54u, 0x6b55bd55u, 0x6f56b555u, 0x55555555u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x003c0000u, 0x00eb00f0u, 0x03afc3acu, 0x03bfcebfu,
  0x0ffffbffu, 0x3affffffu, 0xebffffffu, 0xefffffffu,
  0xffffffffu, 0x3fdffdfcu, 0x05115114u, 0x00100100u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00040000u, 0x00190040u,
  0x006b4190u, 0x01af46b4u, 0x06bf5af4u, 0x1aff6bf5u,
  0x6bff6ffdu, 0x55555555u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x05001400u,
  0x00514000u, 0x00040050u, 0x00000505u, 0x00001000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x05500540u, 0x00000000u, 0x00155000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00010000u, 0x00050000u, 0x00191000u,
  0x00696400u, 0x01a9a900u, 0x01a9a900u, 0x06a9aa40u,
  0x05545540u, 0x00010000u, 0x15555554u, 0x07ffffd0u,
  0x01555540u, 0x00000000u, 0x15505500u, 0x00555000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x15000000u, 0x45400000u,
  0x55405414u, 0x05415515u, 0x05450141u, 0x05540040u,
  0x00000000u, 0x15415515u, 0x00000000u, 0x00000000u
);
// GLYPH-DATA-END

// Sprite ids, in the order the generator lists them.
const int G_MOUNTAIN = 0;
const int G_PEAKS = 1;
const int G_FOREST = 2;
const int G_RIDGE = 3;
const int G_GRASS = 4;
const int G_WAVES = 5;
const int G_SHIP = 6;
const int G_SERPENT = 7;

float hash21(vec2 p) {
  p = fract(p * vec2(123.34, 456.21));
  p += dot(p, p + 45.32);
  return fract(p.x * p.y);
}

float vnoise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  float a = hash21(i);
  float b = hash21(i + vec2(1.0, 0.0));
  float c = hash21(i + vec2(0.0, 1.0));
  float d = hash21(i + vec2(1.0, 1.0));
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

uint terrainByte(vec2 tile) {
  ivec2 tc = clamp(ivec2(floor(tile)), ivec2(0), ivec2(MAP_W - 1, MAP_H - 1));
  return texelFetch(uTerrainBytes, tc, 0).r;
}

bool isPlayableLand(uint b) {
  return (b & 0x80u) != 0u && (b & 0x1fu) != 31u;
}

// 0 = impassable, 1 = plains, 2 = highland, 3 = mountain, 4 = open water,
// 5 = water next to land.
int terrainClass(vec2 tile) {
  uint b = terrainByte(tile);
  uint mag = b & 0x1fu;
  if ((b & 0x80u) != 0u) {
    if (mag == 31u) return 0;
    if (mag < 10u) return 1;
    if (mag < 20u) return 2;
    return 3;
  }
  return (b & 0x40u) != 0u ? 5 : 4;
}

// 1 on land tiles that touch water (the coastline and river banks).
float coastAt(vec2 tile) {
  uint b = terrainByte(tile);
  return ((b & 0xc0u) == 0xc0u && (b & 0x1fu) != 31u) ? 1.0 : 0.0;
}

// Land colour for a tile: elevation smoothed over the neighbourhood (the raw
// data is speckled), cut into flat bands, with alternate rows nudged up or
// down a little so neighbouring bands meet in pixel-art stripes.
// `px` is the size of one screen pixel in tiles.
vec3 landColor(vec2 tile, uint centre, float px) {
  float sum = float(centre & 0x1fu);
  float n = 1.0;
  for (int i = 0; i < 8; i++) {
    // Four diagonal taps 4 tiles out, then four axis taps 8 tiles out.
    float a = float(i & 1) * 2.0 - 1.0;
    float c = float((i >> 1) & 1) * 2.0 - 1.0;
    vec2 axis = c < 0.0 ? vec2(a, 0.0) : vec2(0.0, a);
    vec2 off = i < 4 ? vec2(a, c) * 4.0 : axis * 8.0;
    uint b = terrainByte(tile + off);
    if (isPlayableLand(b)) {
      sum += float(b & 0x1fu);
      n += 1.0;
    }
  }
  float m = sum / n;
  // Zoomed out past a tile per pixel the stripes would alias into wide
  // bands, so they fade away there.
  float dither = 0.9 * clamp(1.6 - px, 0.0, 1.0);
  m += mod(floor(tile.y), 2.0) < 0.5 ? dither : -dither;

  if (m < 4.0) return uPlains;
  if (m < 9.5) return uPlains * vec3(0.72, 0.86, 0.74);
  if (m < 14.0) return uHighland;
  if (m < 19.0) return uHighland * vec3(0.95, 0.74, 0.55);
  if (m < 24.0) return uMountain;
  return mix(uMountain, vec3(1.0), 0.8);
}

// Sprite pixel: 0 transparent, 1 outline, 2 light, 3 main colour.
uint glyphPixel(int id, int x, int y) {
  uint row = GLYPH_ROWS[id * 16 + y];
  return (row >> uint(2 * (15 - x))) & 3u;
}

vec3 glyphColor(int id, uint v) {
  if (v == 1u) return INK;
  bool light = v == 2u;
  if (id == G_MOUNTAIN || id == G_PEAKS) {
    return light ? vec3(1.0, 1.0, 1.0) : vec3(0.72, 0.70, 0.90);
  }
  if (id == G_FOREST) {
    return light ? vec3(0.45, 0.68, 0.44) : vec3(0.25, 0.49, 0.30);
  }
  if (id == G_RIDGE) {
    return light ? vec3(0.96, 0.84, 0.47) : vec3(0.86, 0.47, 0.24);
  }
  // Ship: pale sails, dark hull.
  return light ? vec3(1.0, 0.98, 0.92) : vec3(0.55, 0.27, 0.22);
}

// One glyph layer whose cells are `cell` tiles wide. Returns the sprite
// colour and its coverage (0 or 1).
vec4 glyphLayer(vec2 p, float cell) {
  vec2 g = p / cell;
  // Offset alternate rows by half a cell so the grid doesn't read as a grid.
  float shift = 0.5 * mod(floor(g.y), 2.0);
  g.x += shift;
  vec2 id = floor(g);
  vec2 q = fract(g) - 0.5;

  vec2 seed = id + cell * 0.371;
  float h1 = hash21(seed);
  float h2 = hash21(seed * 1.7 + 11.3);
  float h3 = hash21(seed * 2.3 + 5.1);
  vec2 jitter = (vec2(h1, h2) - 0.5) * (1.0 - GLYPH_SPAN);
  q -= jitter;

  // Sprite pixel under this fragment; bail out early when outside it.
  vec2 gp = floor((q / GLYPH_SPAN + 0.5) * 16.0);
  if (gp.x < 0.0 || gp.x > 15.0 || gp.y < 0.0 || gp.y > 15.0) return vec4(0.0);

  // Glyph centre in tile coordinates; it decides what gets drawn.
  vec2 c = id + 0.5 + jitter;
  c.x -= shift;
  c *= cell;
  int k0 = terrainClass(c);
  if (k0 == 0) return vec4(0.0);

  // Sample the glyph's footprint. Terrain is speckled (mountain tiles mixed
  // into highland), so classify by what the footprint contains, not by the
  // centre tile alone.
  vec2 foot = vec2(0.3, 0.25) * cell;
  int k1 = terrainClass(c + vec2(-foot.x, foot.y));
  int k2 = terrainClass(c + foot);
  int k3 = terrainClass(c + vec2(0.0, -0.25 * cell));
  int k4 = terrainClass(c + vec2(0.12, 0.05) * cell);

  int glyph;
  bool flip = h2 > 0.5;
  if (k0 >= 4) {
    // Sea glyphs only out on open water, clear of every coast.
    if (k0 != 4 || k1 != 4 || k2 != 4 || k3 != 4 || k4 != 4) return vec4(0.0);
    if (h3 < 0.14) {
      glyph = G_WAVES;
    } else if (h3 > 0.99) {
      glyph = G_SHIP;
    } else if (h3 > 0.983) {
      glyph = G_SERPENT;
    } else {
      return vec4(0.0);
    }
  } else {
    // Land glyphs keep both feet and the centre on dry land.
    if (k1 < 1 || k1 > 3 || k2 < 1 || k2 > 3) return vec4(0.0);
    int mtn = int(k0 == 3) + int(k1 == 3) + int(k2 == 3) + int(k3 == 3) +
      int(k4 == 3);
    int high = int(k0 == 2) + int(k1 == 2) + int(k2 == 2) + int(k3 == 2) +
      int(k4 == 2);
    if (mtn >= 2) {
      if (h3 > 0.9) return vec4(0.0);
      glyph = h3 < 0.55 ? G_MOUNTAIN : G_PEAKS;
      flip = false; // keep every peak's shadow on the same side
    } else if (mtn + high >= 2) {
      if (h3 > 0.45) return vec4(0.0);
      glyph = G_RIDGE;
    } else {
      // Woods grow in patches rather than evenly.
      float woods = vnoise(c / (cell * 2.5) + 17.0);
      if (woods > 0.48 && h3 < 0.8) {
        glyph = G_FOREST;
      } else if (h3 < 0.1) {
        glyph = G_GRASS;
      } else {
        return vec4(0.0);
      }
    }
  }

  int gx = int(gp.x);
  if (flip) gx = 15 - gx;
  uint v = glyphPixel(glyph, gx, int(gp.y));
  if (v == 0u) return vec4(0.0);
  return vec4(glyphColor(glyph, v), 1.0);
}
#endif

void main() {
  vec3 col = texture(uTerrain, vUV).rgb;

#if FANTASY_GLYPHS
  vec2 p = vUV * vec2(float(MAP_W), float(MAP_H));
  // Size of one screen pixel in tiles (bigger = zoomed further out).
  float px = max(max(fwidth(p.x), fwidth(p.y)), 1e-4);

  // --- Land in flat elevation bands ---
  uint centre = terrainByte(p);
  if (isPlayableLand(centre)) {
    col = landColor(floor(p), centre, px);
  }

  // --- Inked coastline ---
  // Four taps across the pixel so the one-tile line stays continuous when
  // the camera is zoomed out past one tile per pixel.
  float o = 0.25 * px;
  float coast = 0.25 * (coastAt(p + vec2(-o, -o)) + coastAt(p + vec2(o, -o)) +
    coastAt(p + vec2(-o, o)) + coastAt(p + vec2(o, o)));
  col = mix(col, INK, coast * 0.9);

  // --- Sprite glyphs ---
  // Pick the cell size that keeps glyphs near TARGET_PX on screen, and
  // cross-fade to the next size up as the camera zooms out.
  float lod = log2(px * TARGET_PX / BASE_CELL);
  float l0 = clamp(floor(lod), 0.0, MAX_LOD);
  float lf = clamp(lod - l0, 0.0, 1.0);
  // Close up (lod < 0) the glyphs would outgrow the screen: fade them out.
  float near = smoothstep(-1.0, 0.0, lod);
  float t = (lf > 0.7 && l0 < MAX_LOD) ? smoothstep(0.7, 1.0, lf) : 0.0;
  vec4 glyph = glyphLayer(p, BASE_CELL * exp2(l0));
  col = mix(col, glyph.rgb, glyph.a * (1.0 - t) * near);
  if (t > 0.0) {
    vec4 next = glyphLayer(p, BASE_CELL * exp2(l0 + 1.0));
    col = mix(col, next.rgb, next.a * t * near);
  }
#endif

  fragColor = vec4(col, 1.0);
}
