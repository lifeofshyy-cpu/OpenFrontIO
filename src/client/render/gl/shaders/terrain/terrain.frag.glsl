#version 300 es
precision highp float;
precision highp usampler2D;

// Fantasy-map terrain, bright pixel-art style: flat vivid land with a dark
// outline and a shaded lower rim, blue water in two flat depths with a pale
// foam line along the coast, and sprite glyphs — packed trees for forest,
// overlapping snow-capped peaks for mountains.
//
// Defines injected by TerrainPass: MAP_W, MAP_H, FANTASY_GLYPHS (0 | 1) and,
// with FANTASY_GLYPHS, ELEV_W / ELEV_H (the elevation texture's extent in
// tiles). Without FANTASY_GLYPHS the baked terrain colours are drawn as-is.

uniform sampler2D uTerrain;
#if FANTASY_GLYPHS
// Raw terrain bytes (R8UI): bit 7 land, bit 6 shoreline, bits 0-4 magnitude
// (elevation on land, distance from land on water).
uniform usampler2D uTerrainBytes;
// Smoothed land elevation (R8, bilinear): magnitude × 8 / 255.
uniform sampler2D uElevation;
// Colours from render settings (0-1 RGB): land (plains), tree foliage
// (highland) and mountain rock.
uniform vec3 uPlains;
uniform vec3 uHighland;
uniform vec3 uMountain;
#endif

in vec2 vUV;
out vec4 fragColor;

#if FANTASY_GLYPHS
// Smallest glyph cell, in tiles, and the on-screen size (px) a cell is kept
// near: cells double in size each time the camera zooms out 2x.
const float BASE_CELL = 10.0;
const float TARGET_PX = 56.0;
const float MAX_LOD = 5.0;
// Sprite size relative to its cell. Above 1 so neighbours overlap.
const float PEAK_SPAN = 1.35;
const float TREE_SPAN = 1.25;
// Tree cells per glyph cell, along each axis.
const float TREES_PER_CELL = 2.0;
// Smoothed magnitude at which forest and mountains begin.
const float FOREST_AT = 10.0;
const float MOUNTAIN_AT = 16.0;

// GLYPH-DATA-BEGIN (generated by scripts/gen-terrain-glyphs.mjs)
const int GLYPH_COUNT = 6;
const uint GLYPH_ROWS[96] = uint[96](
  0x00000000u, 0x00014000u, 0x00069000u, 0x001a9400u,
  0x001ad500u, 0x006ad540u, 0x006fd540u, 0x01bfd550u,
  0x01ffd554u, 0x07ffd554u, 0x07ff5554u, 0x1fff5555u,
  0x1ffd5555u, 0x7ffd5555u, 0x7ff55555u, 0x55555555u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00500000u,
  0x01a40140u, 0x06a50690u, 0x06f546d4u, 0x1bf55bd4u,
  0x1ff56fd5u, 0x7ff5bfd5u, 0x7fd5ffd5u, 0x55555555u,
  0x00000000u, 0x00014000u, 0x00069000u, 0x001af400u,
  0x006afd00u, 0x001bf400u, 0x006bfd00u, 0x01abff40u,
  0x06afff50u, 0x016ff500u, 0x06affd40u, 0x1abfff50u,
  0x6affffd4u, 0x157fd550u, 0x001f4000u, 0x00154000u,
  0x00000000u, 0x00000000u, 0x00155000u, 0x016aa500u,
  0x06aabf40u, 0x1aabffd0u, 0x1aafffd0u, 0x6abffff4u,
  0x6afffff4u, 0x6bfffff4u, 0x1fffffd0u, 0x1fffff40u,
  0x05fff500u, 0x005f5000u, 0x001f4000u, 0x00154000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x10100000u, 0x04400404u,
  0x01000110u, 0x00000040u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
  0x00000000u, 0x00000000u, 0x02000000u, 0x08800800u,
  0x20202200u, 0x00008080u, 0x00000000u, 0x00000000u
);
// GLYPH-DATA-END

// Sprite ids, in the order the generator lists them.
const int G_MOUNTAIN = 0;
const int G_PEAKS = 1;
const int G_PINE = 2;
const int G_TREE = 3;
const int G_GRASS = 4;
const int G_WAVES = 5;

float hash21(vec2 p) {
  p = fract(p * vec2(123.34, 456.21));
  p += dot(p, p + 45.32);
  return fract(p.x * p.y);
}

float vnoise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  float a = hash21(i);
  float b = hash21(i + vec2(1.0, 0.0));
  float c = hash21(i + vec2(0.0, 1.0));
  float d = hash21(i + vec2(1.0, 1.0));
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

uint terrainByte(vec2 tile) {
  ivec2 tc = clamp(ivec2(floor(tile)), ivec2(0), ivec2(MAP_W - 1, MAP_H - 1));
  return texelFetch(uTerrainBytes, tc, 0).r;
}

bool isLand(uint b) {
  return (b & 0x80u) != 0u;
}

bool isPlayableLand(uint b) {
  return (b & 0x80u) != 0u && (b & 0x1fu) != 31u;
}

// Open water: not land, and not touching land.
bool isOpenWater(uint b) {
  return (b & 0xc0u) == 0u;
}

// 1 on land tiles that touch water (the coastline and river banks).
float coastAt(vec2 tile) {
  uint b = terrainByte(tile);
  return ((b & 0xc0u) == 0xc0u && (b & 0x1fu) != 31u) ? 1.0 : 0.0;
}

// Smoothed magnitude (0-30) around a tile.
float elevation(vec2 tile) {
  vec2 uv = tile / vec2(float(ELEV_W), float(ELEV_H));
  return texture(uElevation, uv).r * (255.0 / 8.0);
}

// Sprite pixel: 0 transparent, 1 outline, 2 light, 3 main colour.
uint glyphPixel(int id, int x, int y) {
  uint row = GLYPH_ROWS[id * 16 + y];
  return (row >> uint(2 * (15 - x))) & 3u;
}

vec3 glyphColor(int id, uint v) {
  if (id == G_MOUNTAIN || id == G_PEAKS) {
    if (v == 1u) return uMountain * 0.42; // shadowed rock
    return v == 2u ? vec3(1.0) : uMountain; // snow, lit rock
  }
  if (id == G_PINE || id == G_TREE) {
    if (v == 1u) return uHighland * 0.45;
    return v == 2u ? mix(uHighland, uPlains, 0.6) : uHighland;
  }
  if (id == G_GRASS) return uPlains * 0.72;
  return vec3(0.86, 0.93, 1.0); // wave ticks
}

// Sprite pixel coordinates of `p` inside a sprite centred on `c`, or
// (-1, -1) when outside it.
vec2 spritePixel(vec2 p, vec2 c, float size) {
  vec2 gp = floor(((p - c) / size + 0.5) * 16.0);
  if (gp.x < 0.0 || gp.x > 15.0 || gp.y < 0.0 || gp.y > 15.0) return vec2(-1.0);
  return gp;
}

vec4 spriteTexel(int glyph, vec2 gp, bool flip) {
  int gx = int(gp.x);
  if (flip) gx = 15 - gx;
  uint v = glyphPixel(glyph, gx, int(gp.y));
  if (v == 0u) return vec4(0.0);
  return vec4(glyphColor(glyph, v), 1.0);
}

// The peak of glyph cell `id` (cells are `cell` tiles wide) at `p`.
vec4 peakSprite(vec2 p, vec2 id, float cell) {
  vec2 seed = id + cell * 0.371;
  float h1 = hash21(seed);
  float h2 = hash21(seed * 1.7 + 11.3);
  float h3 = hash21(seed * 2.3 + 5.1);
  vec2 c = (id + 0.5 + (vec2(h1, h2) - 0.5) * 0.3) * cell;
  vec2 gp = spritePixel(p, c, cell * PEAK_SPAN);
  if (gp.x < 0.0) return vec4(0.0);
  uint b = terrainByte(c);
  if (!isPlayableLand(b) || (b & 0x40u) != 0u) return vec4(0.0);
  if (elevation(c) < MOUNTAIN_AT) return vec4(0.0);
  // Shadows stay on the right, so peaks are never mirrored.
  return spriteTexel(h3 < 0.65 ? G_MOUNTAIN : G_PEAKS, gp, false);
}

// The tree (or tuft of grass) of tree cell `id` at `p`.
vec4 treeSprite(vec2 p, vec2 id, float cell) {
  vec2 seed = id + cell * 0.731;
  float h1 = hash21(seed);
  float h2 = hash21(seed * 1.9 + 3.7);
  float h3 = hash21(seed * 2.7 + 8.3);
  vec2 c = (id + 0.5 + (vec2(h1, h2) - 0.5) * 0.45) * cell;
  vec2 gp = spritePixel(p, c, cell * TREE_SPAN);
  if (gp.x < 0.0) return vec4(0.0);
  uint b = terrainByte(c);
  if (!isPlayableLand(b) || (b & 0x40u) != 0u) return vec4(0.0);
  float e = elevation(c);
  if (e >= MOUNTAIN_AT) return vec4(0.0);
  if (e < FOREST_AT) {
    // Open country: the odd tuft of grass, and a stray tree near the woods.
    if (h3 > 0.97) return spriteTexel(G_GRASS, gp, h2 > 0.5);
    if (e > FOREST_AT - 2.0 && h3 < 0.12) return spriteTexel(G_TREE, gp, false);
    return vec4(0.0);
  }
  // Pines in the high forest, broadleaf lower down, in drifts.
  float kind = vnoise(c / 60.0 + 5.0) + (e - FOREST_AT) * 0.08;
  return spriteTexel(kind > 0.62 ? G_PINE : G_TREE, gp, false);
}

// Wave ticks out on open water.
vec4 waveSprite(vec2 p, vec2 id, float cell) {
  vec2 seed = id + cell * 0.531;
  float h1 = hash21(seed);
  float h2 = hash21(seed * 1.7 + 11.3);
  float h3 = hash21(seed * 2.3 + 5.1);
  if (h3 > 0.16) return vec4(0.0);
  vec2 c = (id + 0.5 + (vec2(h1, h2) - 0.5) * 0.3) * cell;
  vec2 gp = spritePixel(p, c, cell * 0.7);
  if (gp.x < 0.0) return vec4(0.0);
  vec2 foot = vec2(0.4, 0.3) * cell;
  if (!isOpenWater(terrainByte(c)) || !isOpenWater(terrainByte(c - foot)) ||
    !isOpenWater(terrainByte(c + foot))) {
    return vec4(0.0);
  }
  return spriteTexel(G_WAVES, gp, h2 > 0.5);
}

// All sprites for one level of detail. Sprites overlap their neighbours:
// the cell below is in front, then this row, then the cell above; peaks
// stand in front of trees.
vec4 glyphLayer(vec2 p, float cell, bool onLand) {
  vec2 id = floor(p / cell);
  if (!onLand) return waveSprite(p, id, cell);

  vec4 s = peakSprite(p, id + vec2(0.0, 1.0), cell);
  if (s.a == 0.0) s = peakSprite(p, id, cell);
  if (s.a == 0.0) s = peakSprite(p, id + vec2(-1.0, 0.0), cell);
  if (s.a == 0.0) s = peakSprite(p, id + vec2(1.0, 0.0), cell);
  if (s.a == 0.0) s = peakSprite(p, id + vec2(0.0, -1.0), cell);
  if (s.a > 0.0) return s;

  float tc = cell / TREES_PER_CELL;
  vec2 tid = floor(p / tc);
  s = treeSprite(p, tid + vec2(0.0, 1.0), tc);
  if (s.a == 0.0) s = treeSprite(p, tid, tc);
  if (s.a == 0.0) s = treeSprite(p, tid + vec2(-1.0, 0.0), tc);
  if (s.a == 0.0) s = treeSprite(p, tid + vec2(1.0, 0.0), tc);
  if (s.a == 0.0) s = treeSprite(p, tid + vec2(0.0, -1.0), tc);
  return s;
}
#endif

void main() {
  vec3 col = texture(uTerrain, vUV).rgb;

#if FANTASY_GLYPHS
  vec2 p = vUV * vec2(float(MAP_W), float(MAP_H));
  // Size of one screen pixel in tiles (bigger = zoomed further out).
  float px = max(max(fwidth(p.x), fwidth(p.y)), 1e-4);
  vec2 tile = floor(p) + 0.5;

  uint centre = terrainByte(p);
  bool onLand = isPlayableLand(centre);
  // Thickness of rims and outlines: a couple of tiles, and never thinner
  // than a pixel and a half so they survive zooming out.
  float rim = max(2.0, 1.5 * px);
  if (onLand) {
    // --- Land: one flat colour, darker along its lower (south) edge so it
    // reads as raised above the water ---
    col = uPlains;
    if (!isLand(terrainByte(tile + vec2(0.0, rim))) ||
      !isLand(terrainByte(tile + vec2(0.0, 2.0 * rim)))) {
      col = uPlains * vec3(0.5, 0.62, 0.62);
    }
  } else if (!isLand(centre)) {
    // --- Water: two flat depths with a blocky edge between them. The pale
    // foam line along the coast is already in the baked colour. ---
    float depth = float(centre & 0x1fu);
    vec2 block = floor(tile / 6.0);
    float wobble = vnoise(block / 5.0) * 10.0;
    if ((centre & 0x40u) == 0u && depth + wobble > 17.0) col *= 0.8;
  }

  // --- Dark outline along the coast ---
  // Four taps across the pixel so the one-tile line stays continuous when
  // the camera is zoomed out past one tile per pixel.
  float o = 0.25 * px;
  float coast = 0.25 * (coastAt(p + vec2(-o, -o)) + coastAt(p + vec2(o, -o)) +
    coastAt(p + vec2(-o, o)) + coastAt(p + vec2(o, o)));
  col = mix(col, uPlains * vec3(0.28, 0.4, 0.42), coast);

  // --- Sprite glyphs ---
  // Pick the cell size that keeps glyphs near TARGET_PX on screen, and
  // cross-fade to the next size up as the camera zooms out.
  float lod = log2(px * TARGET_PX / BASE_CELL);
  float l0 = clamp(floor(lod), 0.0, MAX_LOD);
  float lf = clamp(lod - l0, 0.0, 1.0);
  // Close up (lod < 0) the glyphs would outgrow the screen: fade them out.
  float near = smoothstep(-1.0, 0.0, lod);
  float t = (lf > 0.7 && l0 < MAX_LOD) ? smoothstep(0.7, 1.0, lf) : 0.0;
  vec4 glyph = glyphLayer(p, BASE_CELL * exp2(l0), onLand);
  col = mix(col, glyph.rgb, glyph.a * (1.0 - t) * near);
  if (t > 0.0) {
    vec4 next = glyphLayer(p, BASE_CELL * exp2(l0 + 1.0), onLand);
    col = mix(col, next.rgb, next.a * t * near);
  }
#endif

  fragColor = vec4(col, 1.0);
}
